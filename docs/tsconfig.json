{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "press.config.tsx",
    "vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".fumapress/**/*.ts",
    ".fumapress/**/*.tsx"
  ]
}
