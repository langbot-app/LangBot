  "mock-daily-tool-timeout-recovery": {
    "steps": [
      {
        "tool_calls": [
          {
            "name": "exec",
            "arguments": {
              "command": "rm -f /tmp/langbot-timeout-leak; sleep 3; printf LEAK > /tmp/langbot-timeout-leak",
              "timeout_sec": 1
            }
          }
        ]
      },
      {
        "expect_tool_output": "timed_out",
        "tool_calls": [
          {
            "name": "exec",
            "arguments": {
              "command": "sleep 3; test ! -e /tmp/langbot-timeout-leak && printf TIMEOUT_RECOVERY_OK"
            }
          }
        ]
      },
      {
        "expect_tool_output": "TIMEOUT_RECOVERY_OK",
        "content": "LANGBOT_TOOL_TIMEOUT_RECOVERY_OK"
      }
    ]
  },
