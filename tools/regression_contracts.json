{
  "version": 1,
  "scope": "Registered CLI/HTTP Bot, conversation, model, tool and retrieval behavior obligations plus explicit adjacent-risk gaps. This is not all product features, all API endpoints, code coverage, or real-model quality coverage. Case repetition does not increase the denominator.",
  "contracts": [
    {"id": "configuration.identity",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "CLI resolves the configured Workspace identity",
     "bindings": [{"profile": "smoke", "case": "identity", "checks": ["response"]}, {"profile": "scenarios", "case": "identity", "checks": ["response"]}]
    },
    {"id": "configuration.plugins",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "Installed LocalAgent is visible through the plugin API",
     "bindings": [{"profile": "smoke", "case": "plugins", "checks": ["response"]}, {"profile": "scenarios", "case": "plugins", "checks": ["response"]}],
     "routes": ["GET /api/v1/plugins"]
    },
    {"id": "configuration.provider_readback",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "Created provider is visible through the public API",
     "bindings": [{"profile": "smoke", "case": "provider_readback", "checks": ["response"]}, {"profile": "scenarios", "case": "provider_readback", "checks": ["response"]}],
     "routes": ["GET /api/v1/provider/providers/<provider_uuid>"]
    },
    {"id": "configuration.model_readback",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "Created model is visible through the public API",
     "bindings": [{"profile": "smoke", "case": "model_readback", "checks": ["response"]}, {"profile": "scenarios", "case": "model_readback", "checks": ["response"]}],
     "routes": ["GET /api/v1/provider/models/llm/<model_uuid>"]
    },
    {"id": "configuration.pipeline_readback",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "Pipeline readback includes its configured model",
     "bindings": [{"profile": "smoke", "case": "pipeline_readback", "checks": ["response"]}, {"profile": "scenarios", "case": "pipeline_readback", "checks": ["response"]}],
     "routes": ["GET /api/v1/pipelines/<pipeline_uuid>"]
    },
    {"id": "configuration.kb_readback",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "Knowledge-base identity and engine match configuration",
     "bindings": [{"profile": "smoke", "case": "kb_readback", "checks": ["response", "fields"]}, {"profile": "scenarios", "case": "kb_readback", "checks": ["response", "fields"]}],
     "routes": ["GET /api/v1/knowledge/bases/<knowledge_base_uuid>"]
    },
    {"id": "configuration.document_readback",
     "area": "configuration", "kind": "blackbox", "priority": "P1",
     "description": "Uploaded document completes ingestion in its owning knowledge base",
     "bindings": [{"profile": "smoke", "case": "document_readback", "checks": ["response", "fields"]}, {"profile": "scenarios", "case": "document_readback", "checks": ["response", "fields"]}],
     "routes": ["GET /api/v1/knowledge/bases/<knowledge_base_uuid>/files"]
    },
    {"id": "ingress.missing_signature",
     "area": "ingress", "kind": "blackbox", "priority": "P0",
     "description": "Unsigned bot messages are rejected",
     "bindings": [{"profile": "smoke", "case": "missing_signature", "checks": ["response", "fields"]}, {"profile": "scenarios", "case": "missing_signature", "checks": ["response", "fields"]}]
    },
    {"id": "ingress.bad_signature",
     "area": "ingress", "kind": "blackbox", "priority": "P0",
     "description": "Messages with an invalid signature are rejected",
     "bindings": [{"profile": "smoke", "case": "bad_signature", "checks": ["response", "fields"]}, {"profile": "scenarios", "case": "bad_signature", "checks": ["response", "fields"]}]
    },
    {"id": "conversation.chat",
     "area": "conversation", "kind": "blackbox", "priority": "P1",
     "description": "Pipeline returns the expected chat response",
     "bindings": [{"profile": "smoke", "case": "chat", "checks": ["response"]}, {"profile": "endurance", "case": "chat", "checks": ["response"]}, {"profile": "scenarios", "case": "chat", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "conversation.unicode",
     "area": "conversation", "kind": "blackbox", "priority": "P1",
     "description": "Unicode input and streamed output survive the full conversation chain",
     "bindings": [{"profile": "smoke", "case": "unicode", "checks": ["response"]}, {"profile": "scenarios", "case": "unicode", "checks": ["response"]}, {"profile": "scenarios", "case": "group_unicode", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "model.slow",
     "area": "model", "kind": "blackbox", "priority": "P1",
     "description": "Slow streamed model output reaches the caller",
     "bindings": [{"profile": "smoke", "case": "slow", "checks": ["response", "model_sequence"]}, {"profile": "scenarios", "case": "slow", "checks": ["response", "model_sequence"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "model.fallback401",
     "area": "model", "kind": "blackbox", "priority": "P1",
     "description": "Authentication failure falls back to the configured secondary model",
     "bindings": [{"profile": "smoke", "case": "fallback401", "checks": ["response", "model_sequence"]}, {"profile": "scenarios", "case": "fallback401", "checks": ["response", "model_sequence"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "model.fallback429",
     "area": "model", "kind": "blackbox", "priority": "P1",
     "description": "Rate limiting falls back to the configured secondary model",
     "bindings": [{"profile": "smoke", "case": "fallback429", "checks": ["response", "model_sequence"]}, {"profile": "scenarios", "case": "fallback429", "checks": ["response", "model_sequence"]}, {"profile": "scenarios", "case": "group_fallback429", "checks": ["response", "model_sequence"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "model.fallback503",
     "area": "model", "kind": "blackbox", "priority": "P1",
     "description": "Unavailable primary model falls back to the secondary model",
     "bindings": [{"profile": "smoke", "case": "fallback503", "checks": ["response", "model_sequence"]}, {"profile": "scenarios", "case": "fallback503", "checks": ["response", "model_sequence"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "tools.exec_error",
     "area": "tools", "kind": "blackbox", "priority": "P1",
     "description": "Tool error output is delivered to the model and handled",
     "bindings": [{"profile": "smoke", "case": "exec_error", "checks": ["response"]}, {"profile": "scenarios", "case": "exec_error", "checks": ["response"]}, {"profile": "scenarios", "case": "group_exec_error", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "tools.parallel",
     "area": "tools", "kind": "blackbox", "priority": "P1",
     "description": "Parallel tool calls return matched results to the model",
     "bindings": [{"profile": "smoke", "case": "parallel", "checks": ["response"]}, {"profile": "scenarios", "case": "parallel", "checks": ["response"]}, {"profile": "scenarios", "case": "group_parallel", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "delivery.unicode_export",
     "area": "delivery", "kind": "blackbox", "priority": "P1",
     "description": "Exported Unicode file name and bytes survive delivery",
     "bindings": [{"profile": "smoke", "case": "unicode_export", "checks": ["response", "attachment"]}, {"profile": "scenarios", "case": "unicode_export", "checks": ["response", "attachment"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "retrieval.other_rag",
     "area": "retrieval", "kind": "blackbox", "priority": "P1",
     "description": "A second knowledge base supplies its own content to the model",
     "bindings": [{"profile": "smoke", "case": "other_rag", "checks": ["response"]}, {"profile": "scenarios", "case": "other_rag", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "tools.box",
     "area": "tools", "kind": "blackbox", "priority": "P1",
     "description": "A real Box write/read round trip reaches the final reply",
     "bindings": [{"profile": "smoke", "case": "box", "checks": ["response"]}, {"profile": "endurance", "case": "box", "checks": ["response"]}, {"profile": "scenarios", "case": "box", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "delivery.box_export",
     "area": "delivery", "kind": "blackbox", "priority": "P1",
     "description": "Exported file bytes match the generated fixture",
     "bindings": [{"profile": "smoke", "case": "box_export", "checks": ["response", "attachment"]}, {"profile": "scenarios", "case": "box_export", "checks": ["response", "attachment"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "retrieval.rag_chat",
     "area": "retrieval", "kind": "blackbox", "priority": "P1",
     "description": "Retrieved fixture content reaches the model and final reply",
     "bindings": [{"profile": "smoke", "case": "rag_chat", "checks": ["response"]}, {"profile": "endurance", "case": "rag_chat", "checks": ["response"]}, {"profile": "scenarios", "case": "rag_chat", "checks": ["response"]}],
     "routes": ["POST /api/v1/pipelines/<pipeline_uuid>/run"]
    },
    {"id": "retrieval.rag_retrieve",
     "area": "retrieval", "kind": "blackbox", "priority": "P0",
