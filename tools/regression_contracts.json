     "bindings": [{"profile": "scenarios", "case": "model.stream_disconnect", "checks": ["run_status", "fault_injected", "no_fallback_after_partial", "recovered"]}]
    },
    {"id": "model.exhausted_fallback",
     "area": "model", "kind": "blackbox", "priority": "P1",
     "description": "Failure of every configured model reaches a visible failed outcome",
     "bindings": [{"profile": "scenarios", "case": "model.exhausted_fallback", "checks": ["run_status", "fallback_exhausted", "recovered"]}]
    },
    {"id": "tools.path_escape",
     "area": "tools", "kind": "blackbox", "priority": "P0",
