     "bindings": [{"profile": "smoke", "case": "rag_retrieve", "checks": ["response", "fields", "isolation"]}, {"profile": "scenarios", "case": "rag_retrieve", "checks": ["response", "fields", "isolation"]}],
     "routes": ["POST /api/v1/knowledge/bases/<knowledge_base_uuid>/retrieve"]
    },
    {"id": "retrieval.retrieve_other",
     "area": "retrieval", "kind": "blackbox", "priority": "P0",
     "description": "Retrieval from the second knowledge base excludes the first fixture",
     "bindings": [{"profile": "smoke", "case": "retrieve_other", "checks": ["response", "fields", "isolation"]}, {"profile": "scenarios", "case": "retrieve_other", "checks": ["response", "fields", "isolation"]}],
     "routes": ["POST /api/v1/knowledge/bases/<knowledge_base_uuid>/retrieve"]
    },
    {"id": "retrieval.retrieve_empty",
     "area": "retrieval", "kind": "blackbox", "priority": "P1",
     "description": "Empty knowledge base returns an empty retrieval result",
     "bindings": [{"profile": "smoke", "case": "retrieve_empty", "checks": ["response", "fields"]}, {"profile": "scenarios", "case": "retrieve_empty", "checks": ["response", "fields"]}],
     "routes": ["POST /api/v1/knowledge/bases/<knowledge_base_uuid>/retrieve"]
    },
    {"id": "conversation.group_chat_history",
     "area": "conversation", "kind": "blackbox", "priority": "P0",
     "description": "Multi-turn chat preserves the prior reply without mixing group history",
     "bindings": [{"profile": "smoke", "case": "group_chat_history", "checks": ["response"], "min_turn": 2}, {"profile": "endurance", "case": "chat", "checks": ["response"], "min_turn": 2}, {"profile": "scenarios", "case": "group_chat_history", "checks": ["response"], "min_turn": 2}]
    },
    {"id": "conversation.group_box_history",
     "area": "conversation", "kind": "blackbox", "priority": "P1",
     "description": "Multi-turn Box conversation preserves group history",
     "bindings": [{"profile": "smoke", "case": "group_box_history", "checks": ["response"], "min_turn": 2}, {"profile": "endurance", "case": "box", "checks": ["response"], "min_turn": 2}, {"profile": "scenarios", "case": "group_box_history", "checks": ["response"], "min_turn": 2}]
    },
    {"id": "conversation.group_rag_history",
     "area": "conversation", "kind": "blackbox", "priority": "P1",
     "description": "Multi-turn RAG conversation preserves group history",
     "bindings": [{"profile": "smoke", "case": "group_rag_history", "checks": ["response"], "min_turn": 2}, {"profile": "endurance", "case": "rag_chat", "checks": ["response"], "min_turn": 2}, {"profile": "scenarios", "case": "group_rag_history", "checks": ["response"], "min_turn": 2}]
    },
    {"id": "auth.invalid_credentials",
     "area": "auth", "kind": "blackbox", "priority": "P0",
     "description": "Invalid API credentials cannot access Workspace resources",
     "bindings": [{"profile": "scenarios", "case": "api_auth_invalid", "checks": ["response", "fields"]}],
     "routes": ["GET /api/v1/pipelines"]
    },
    {"id": "auth.revocation",
     "area": "auth", "kind": "blackbox", "priority": "P0",
     "description": "Revoked credentials stop authorizing new requests",
     "bindings": [{"profile": "scenarios", "case": "auth_revocation", "checks": ["credential_active", "credential_revoked", "key_status", "key_cleanup"]}]
    },
    {"id": "workspace.read_isolation",
     "area": "workspace", "kind": "blackbox", "priority": "P0",
     "description": "One Workspace cannot read another Workspace resource",
     "bindings": []
    },
    {"id": "workspace.write_isolation",
     "area": "workspace", "kind": "blackbox", "priority": "P0",
     "description": "One Workspace cannot change another Workspace resource",
     "bindings": []
    },
    {"id": "execution.cancel_cleanup",
     "area": "execution", "kind": "blackbox", "priority": "P0",
     "description": "Cancelling a running execution reaches cancelled state and releases its work",
     "bindings": [{"profile": "scenarios", "case": "execution.cancel_cleanup", "checks": ["run_status", "exec_active", "exec_stopped", "no_late_side_effect"]}]
    },
    {"id": "execution.timeout_cleanup",
     "area": "execution", "kind": "blackbox", "priority": "P0",
     "description": "Deadline expiry stops child work and allows a subsequent request",
     "bindings": [{"profile": "scenarios", "case": "execution.timeout_cleanup", "checks": ["run_status", "exec_active", "exec_stopped", "no_late_side_effect"]}]
    },
    {"id": "execution.retry_side_effects",
     "area": "execution", "kind": "blackbox", "priority": "P0",
