      "body": {
        "name": "regression group chat",
        "description": "Synthetic signed group ingress",
        "adapter": "http_bot",
        "enable": true,
        "adapter_config": {
          "inbound_secret": "${group_secret}",
          "signature_required": true,
          "callback_url": "http://127.0.0.1:9/unused-sync-only",
          "default_session_type": "group",
          "callback_timeout": 20,
          "callback_max_retries": 0
        },
        "event_bindings": [
          {
            "event_pattern": "message.received",
            "target_type": "pipeline",
            "target_uuid": "${chat_pipeline}",
            "enabled": true,
            "filters": []
          }
