    {
      "id": "chat_pipeline",
      "kind": "pipeline",
      "body": {
        "name": "regression chat",
        "description": "Normal deterministic chat",
        "config": {
          "ai": {
            "runner": {
              "id": "plugin:langbot-team/LocalAgent/default",
              "expire-time": 0
            },
            "runner_config": {
              "plugin:langbot-team/LocalAgent/default": {
                "model": {
                  "primary": "${chat_model}",
                  "fallbacks": []
                },
                "prompt": [
                  {
                    "role": "system",
                    "content": "You are a QA regression assistant."
                  }
                ],
                "knowledge-bases": [],
                "box-enabled": false,
                "timeout": 30,
                "max-round": 20
              }
            }
          },
          "safety": {
            "rate-limit": {
              "limitation": 10000
            }
          },
          "output": {
            "force-delay": {
              "min": 0,
              "max": 0
            },
            "misc": {
              "at-sender": false,
              "quote-origin": false
            }
          },
          "trigger": {
            "group-respond-rules": {
              "prefix": [
                "ai "
              ]
            }
          }
        }
      }
    },
    {
      "id": "box_pipeline",
