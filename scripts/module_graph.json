{
  "schema_version": 1,
  "description": "Declarative runtime dependency graph and hidden-internal boundaries for all top-level packages under src/langbot/pkg/ (see #3206).",
  "layers": [
    "foundation",
    "infrastructure",
    "domain",
    "orchestration",
    "interface",
    "bootstrap"
  ],
  "modules": {
    "config": {
      "layer": "foundation",
      "depends_on": []
    },
    "entity": {
      "layer": "foundation",
      "depends_on": [
        "persistence"
      ]
    },
    "i18n": {
      "layer": "foundation",
      "depends_on": [
        "entity",
        "persistence"
      ]
    },
    "notification": {
      "layer": "foundation",
      "depends_on": [
        "utils"
      ]
    },
    "utils": {
      "layer": "foundation",
      "depends_on": [
        "core",
        "entity",
        "persistence",
        "workspace"
      ]
    },
    "discover": {
      "layer": "infrastructure",
      "depends_on": [
        "core",
        "utils"
      ]
    },
    "operation_trace": {
      "layer": "infrastructure",
      "depends_on": [
        "api",
        "core",
        "entity",
        "utils"
      ]
    },
    "persistence": {
      "layer": "infrastructure",
      "depends_on": [
        "api",
        "cloud",
        "core",
        "entity",
        "platform",
        "storage",
        "utils"
      ],
      "private_submodules": [
        "databases",
        "migrations",
        "alembic"
      ],
      "notes": "Upward runtime deps (api/cloud/core/platform/storage) are legacy debt tracked in #3196 and #3200; private_submodules hide concrete DB drivers and migrations."
    },
    "storage": {
      "layer": "infrastructure",
      "depends_on": [
        "api",
        "core",
        "entity",
        "i18n",
        "persistence",
        "utils"
      ]
    },
    "telemetry": {
      "layer": "infrastructure",
      "depends_on": [
        "command",
        "core",
        "entity",
        "message_policy",
        "utils"
      ]
    },
    "vector": {
      "layer": "infrastructure",
      "depends_on": [
        "api",
        "core",
        "entity",
        "utils",
        "workspace"
      ]
    },
    "alerts": {
      "layer": "domain",
      "depends_on": [
        "entity",
        "i18n",
        "notification",
        "persistence",
        "telemetry",
        "utils",
        "workspace"
      ]
    },
    "box": {
      "layer": "domain",
      "depends_on": [
        "agent",
